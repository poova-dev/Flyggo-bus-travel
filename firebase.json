{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "js/seed-data.js"
    ],
    "cleanUrls": true
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
